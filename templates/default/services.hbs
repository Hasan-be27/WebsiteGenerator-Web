<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>
        {{service.name}} | {{business.name}}
    </title>

    <meta
        name="description"
        content="{{service.brief}}">

    <link
        rel="icon"
        href="../assets/icons/favicon.ico">

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

    <link
        rel="stylesheet"
        href="../assets/css/style.css">

</head>

<body>

    <main>

        <section class="service-detail-page">

            <div class="container">

                <div class="service-detail">

                    <a
                        href="../index.html"
                        class="btn btn-outline-primary service-back">

                        <i class="bi bi-arrow-left me-2"></i>

                        Back to Home

                    </a>

                    <img
                        src="{{service.image}}"
                        alt="{{service.name}}"
                        class="service-detail-image">

                    <h1>
                        {{service.name}}
                    </h1>

                    <p class="service-detail-brief">
                        {{service.brief}}
                    </p>

                    <div class="service-detail-description">

                        <p>
                            {{service.description}}
                        </p>

                    </div>

                    <a
                        href="../index.html"
                        class="btn btn-primary">

                        <i class="bi bi-house me-2"></i>

                        Back to Home

                    </a>

                </div>

            </div>

        </section>

    </main>

</body>

</html>