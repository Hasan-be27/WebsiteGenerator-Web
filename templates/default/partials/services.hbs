<section id="services" class="reveal">

    <div class="container">

        <h2 class="section-title">

            Our Services

        </h2>

        <p class="section-subtitle">

            What We Offer

        </p>

        <div class="services-grid">

            {{#each services}}

            <div class="service-card">

                <div class="service-icon">

                    <i class="bi bi-briefcase-fill"></i>

                </div>

                <h4>
                    {{name}}
                </h4>

                <p>
                    {{description}}
                </p>

            </div>

            {{/each}}

        </div>

    </div>

</section>