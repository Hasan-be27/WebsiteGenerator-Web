<section id="about" class="reveal">

    <div class="container">

        <div class="row align-items-center g-5">

            <div class="col-lg-6">

                <div class="about-image">

                    <img
                        src="{{about.image}}"
                        alt="{{about.heading}}">

                </div>

            </div>

            <div class="col-lg-6">

                <h2>

                    {{about.heading}}

                </h2>

                <p>

                    {{about.description}}

                </p>

            </div>

        </div>

    </div>

</section>